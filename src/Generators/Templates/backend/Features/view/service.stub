<?php

namespace [[namespace]]\Services;

use App\Project\_Src\Helpers;
use App\Project\_Src\ApplicationException;
use Illuminate\Support\Facades\DB;
use Illuminate\Database\Eloquent\Builder;
use [[namespace]]\[[ModuleName]]Model;

class [[ModuleName]]ViewService
{

    protected static array $eagerLoadRelationships = [[eagerLoadRelationships]];

    /**
     * @param array $params Route params ([[routeKeyParam]])
     * @param Builder|null $query Base query, pre-scoped by a caller (e.g. a
     *        delegation service forcing a parent-record filter). Defaults to
     *        a fresh, unscoped query when omitted.
     */
    public static function execute(array $params, ?Builder $query = null)
    {
        try {
            $validParams = self::validateParams($params);
            $baseQuery = $query ?? [[ModuleName]]Model::query()[[withTrashedCall]];
            // Record scope seam: an app whose BaseModel defines applyRecordScope() narrows this
            // fetch to the rows the acting user may reach, so an out-of-scope [[routeKeyParam]] is "not found"
            // below exactly like a missing one. No-op in an app without that method.
            if (method_exists([[ModuleName]]Model::class, 'applyRecordScope')) {
                $baseQuery = [[ModuleName]]Model::applyRecordScope($baseQuery);
            }
            $model = $baseQuery->where(['[[routeKeyParam]]' => $validParams['[[routeKeyParam]]']])->first();
            if(!$model) abort(404, 'Record not found');
            return self::process($validParams, $model);
        } catch(ApplicationException $e) {
            return Helpers::error($e->getMessage(), 422, $e->getData());
        } catch(\Exception $e) {
            throw $e;
        }
    }

    protected static function validateParams(array $params): array
    {
        return validator(
            $params,
            [
				'[[routeKeyParam]]' => ["required", "[[routeKeyRule]]"],
			], [
				'[[routeKeyParam]].[[routeKeyRule]]' => 'The [[routeKeyLabel]] must be a [[routeKeyRule]].',
				'[[routeKeyParam]].required' => 'The [[routeKeyLabel]] is required.',
			]
        )->validate();
    }

    public static function afterFetch(array $validParams, [[ModuleName]]Model $model): array
    {
        $model->load(self::$eagerLoadRelationships);
        $data = $model->toArray();
        [[inlineItemsLoad]]
        return $data;
    }

    public static function process(array $validParams, [[ModuleName]]Model $model): array
    {
        $data = self::afterFetch($validParams, $model);
        return Helpers::success($data, "Record fetched successfully");
    }
}
