<?php

namespace [[namespace]]\Services;

use App\Project\_Src\Helpers;
use [[namespace]]\[[ModuleName]]Model;
use Illuminate\Pagination\LengthAwarePaginator;
use Illuminate\Database\Eloquent\Builder;
use App\Project\_Src\ListServiceTrait;

class [[ModuleName]]ListService
{
    use ListServiceTrait;

    protected static array $bulkActions = [[bulkActionsArray]];
[[bulkRecordKeyColumn]]

    protected static array $defaultListFilters = [[defaultListFiltersArray]];

    /**
     * List of columns that can be filtered
     */
    protected static array $filterableFields = [[filterableFields]];

    /**
     * List of columns that can be sorted
     */
    protected static array $sortableFields = [[sortableFields]];

    /**
     * Sort column/direction used when the request specifies none, and the
     * fallback when an invalid ?sort= is given. 'created_at' unless this
     * module's timestamps are named differently (timestamp_columns).
     */
    protected static string $defaultSortField = '[[defaultSortField]]';

    /**
     * List of relationships and their fields that can be filtered
     * Format: ['relationship' => ['field1', 'field2']]
     */
    protected static array $filterableRelationships = [[filterableRelationships]];

    /**
     * List of relationships to eager load
     */
    protected static array $eagerLoadRelationships = [[eagerLoadRelationships]];
[[locationScopeIncludesNull]]

    /**
     * Get a paginated list of items
     *
     * @param array $data Request data
     * @param bool $export
     * @param string $format
     * @param Builder|null $query Base query, pre-scoped by a caller (e.g. a delegation
     *        service forcing a parent-record filter). Defaults to a fresh, unscoped
     *        query when omitted — every existing caller keeps its current behavior.
     * @param callable|null $enrich fn (array $rows, array $data): array — adds fields to the
     *        rows of this page and of exports; must return one row per row. Define it in a
     *        hand-owned service, never in this file (regenerated wholesale on --force).
     *        Custom view = pre-scoped $query + this enricher; aggregates via
     *        static::scopedQuery()/listCounts(). A consuming app's ListServiceTrait older
     *        than this seam ignores this extra argument.
     * @return array Paginated results
     */
    public static function execute(array $data, bool $export = false, string $format = 'csv', ?Builder $query = null, ?callable $enrich = null): mixed
    {
        // Initialize params array if not provided
        $data['params'] = $data['params'] ?? [];
        $data['filters'] = $data['filters'] ?? [];

        $validData = self::validateData($data);

        if($export) {
            return self::export($validData, $format, $query, $enrich);
        } else {
            return self::process($validData, $query, $enrich);
        }
    }

    /**
     * @param Builder|null $query Base query, pre-scoped by a caller (e.g. a delegation
     *        service forcing a parent-record filter). Defaults to a fresh, unscoped
     *        query when omitted — every existing caller keeps its current behavior.
     */
    public static function execute_bulkAction(array $data, ?Builder $query = null): array
    {
        return self::processBulkAction($data, $query ?? [[ModuleName]]Model::query());
    }

    public static function export(array $data, string $format = 'csv', ?Builder $query = null, ?callable $enrich = null): mixed
    {
        return self::exportData($data, $query ?? [[ModuleName]]Model::query(), false, $format, $enrich);
    }

    protected static function formatDataForExport(array $data): array
    {
        return $data;
    }

[[importMethods]]

    /**
     * Validate input data
     *
     * @param array $data Request data
     * @return array Validated data
     */
    protected static function validateData(array $data): array
    {
        return validator(
            $data,
            [
                'filters' => ["nullable", "array"],
                'params' => ["nullable", "array"],
                'params.page' => ["nullable", "integer"],
                'params.per_page' => ["nullable", "integer"],
                'params.sort' => ["nullable", "string"],
                'params.order' => ["nullable", "string"],
                'params.paginate' => ["nullable"],
            ]
        )->validate();
    }

    /**
     * Process the list request
     *
     * @param array $data Validated request data
     * @param Builder|null $query Base query, pre-scoped by a caller. Defaults to a
     *        fresh, unscoped query when omitted.
     * @return array
     */
    protected static function process(array $data, ?Builder $query = null, ?callable $enrich = null): array
    {
        //Put your query object here.
        $processListQuery = $query ?? [[ModuleName]]Model::query();

        $data = self::processListQuery($data, $processListQuery, true, $enrich);

        // Filter fields define the available filters in the frontend list UI.
        // Each entry supports: key (field name), label, type (text|number|date|select|boolean)
        // For 'select' type, include 'options' with an id/name query.
        // Example:
        // $data['filterFields'] = [
        //     ['key' => 'name', 'label' => 'Name', 'type' => 'text'],
        //     ['key' => 'status_id', 'label' => 'Status', 'type' => 'select',
        //      'options' => \App\Project\Modules\Core\Statuses\StatusesModel::query()->select(['id', 'name'])->get()],
        //     ['key' => 'created_at', 'label' => 'Created At', 'type' => 'date'],
        // ];
        $data['filterFields'] = [[filterFields]];

        return Helpers::success($data, "Records fetched successfully");
    }
}
