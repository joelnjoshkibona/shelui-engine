<?php

namespace [[namespace]]\Services;

use App\Project\_Src\Helpers;
use App\Project\_Src\ApplicationException;
use [[namespace]]\[[ModuleName]]Model;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Auth;

class [[ModuleName]]CreateService
{

    /**
     * @param array $data Request data
     * @param array $params Server-forced field overrides, merged into $validData
     *        AFTER validateData() runs. Always wins over whatever the client sent
     *        for the same key, and survives even when this class's own validation
     *        rules don't declare that column at all (Laravel's validate() only
     *        returns declared rule keys — a pre-validation merge alone can't
     *        guarantee that). Used by delegation services to force a parent-scope
     *        FK; empty for every other caller today.
     */
    public static function execute(array $data, array $params = [])
    {
        DB::beginTransaction();
        try{
            $inlineData = [];
            [[inlineItemsExtract]]
            $validData = self::validateData($data);
            if (!empty($params)) {
                $validData = array_merge($validData, $params);
            }
            $result = self::process($validData, $inlineData);
            DB::commit();
            return $result;
        } catch(ApplicationException $e) {
            DB::rollBack();
            return Helpers::error($e->getMessage(), 422, $e->getData());
        } catch(\Illuminate\Database\UniqueConstraintViolationException $e) {
            DB::rollBack();
            return Helpers::error('This record conflicts with an existing one (duplicate value for a unique field or field combination).', 422);
        } catch(\Exception $e) {
            DB::rollBack();
            throw $e;
        }
    }

    protected static function validateData(array $data): array
    {
        return validator(
            $data,
            [[validationRules]],
            [[validationMessages]]
        )->validate();
    }

    public static function process(array $validData, array $inlineData = []): array
    {
        $validData = self::beforeCreate($validData);
        $model = [[ModuleName]]Model::create($validData);
        [[inlineItemsSave]]
        $data = self::afterCreate($validData, $model->fresh());
        return Helpers::success($data, "Record created successfully", 201);
    }

    public static function beforeCreate($validData) {
        //Before Create
        [[createdByAssignment]]
        [[beforeCreate]]
        return $validData;
    }

    public static function afterCreate($validData, [[ModuleName]]Model $model): [[ModuleName]]Model {
        //After Create
        [[afterCreate]]
        return $model;
    }
}
