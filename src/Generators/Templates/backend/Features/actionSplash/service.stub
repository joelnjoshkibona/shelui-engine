<?php

namespace [[namespace]]\Services;

use App\Project\_Src\Helpers;
use App\Project\_Src\ApplicationException;

/**
 * Splash data for the "[[actionLabel]]" action.
 *
 * Answers GET /[[moduleRoute]]/{[[routeKeyParam]]}/[[actionRoute]]/splash — everything the action's form needs to
 * render before the user has entered anything: option lists, defaults, values derived from the
 * record being acted on. The record's [[routeKeyParam]] is passed, unlike create's splash, because an action
 * always operates on an existing row and its choices usually depend on that row's state.
 *
 * Write-once: filled in by hand and never regenerated, exactly like the action's own Service.
 */
class [[ModuleName]][[ActionName]]SplashService
{
    public static function execute(string $[[routeKeyParam]], array $data = [])
    {
        try {
            return self::process($[[routeKeyParam]], $data);
        } catch (ApplicationException $e) {
            return Helpers::error($e->getMessage(), 422, $e->getData());
        } catch (\Exception $e) {
            throw $e;
        }
    }

    public static function process(string $[[routeKeyParam]], array $data = []): array
    {
        $splashData = [
            [[splashData]]
        ];

        return Helpers::success($splashData, 'Data fetched successfully');
    }
}
