<template>
	<!--
		Reuses ListPanel, the same shared component the standalone list page
		uses (features/list/page.stub) — this tab used to hand-roll its own,
		independent create/edit/view/delete modal state machine, which is what
		let a delegation-specific RelatedModuleFormGenerator quietly overwrite
		the related module's own native CreateForm.vue/EditForm.vue at the same
		file path (see CustomFeatureTabComponentGenerator.php's docblock). Now
		both surfaces resolve to the SAME native Create/Edit/Delete/View
		components — the only difference is the endpoint/permission each is
		pointed at.

		mode="ajax", not "history": an embedded child list must not fight the
		parent page (or any other ListTable instance on it) for URL
		query-param ownership.
	-->
	<ListPanel
		ref="panelRef"
		:endpoint="apiEndpoint"
		:columns="columns"
		:filter-fields="filterFields"
		mode="ajax"
		:create-component="[[createComponent]]"
		:edit-component="[[editComponent]]"
		:delete-component="[[deleteComponent]]"
		:view-component="[[viewComponent]]"
		:can-create="[[hasCreate]]"
		:can-edit="[[hasEdit]]"
		:can-view="[[hasView]]"
		:can-delete="[[hasDelete]]"
		:create-permission="createPermission"
		:edit-permission="editPermission"
		:view-permission="viewPermission"
		:delete-permission="deletePermission"
		:parent-uuid="uuid"
		:create-hiddens="createHiddens"
		:create-defaults="createDefaults"
		:edit-hiddens="editHiddens"
		:edit-defaults="editDefaults"
		:create-submit-url="createSubmitUrl"
		:edit-submit-url="editSubmitUrl"
		:delete-submit-url="deleteSubmitUrl"
		:delete-check-url="deleteCheckUrl"
		:view-submit-url="viewSubmitUrl"
		create-title="Create [[FeatureName]]"
		edit-title="Edit [[FeatureName]]"
		delete-title="Delete [[FeatureName]]"
		view-title="View [[FeatureName]]"
		:test-id-prefix="testIdPrefix"
		create-label="Add [[FeatureName]]"
		:enable-export="[[enableExport]]"
		:enable-bulk-actions="[[enableBulkActions]]"
		:bulk-actions="bulkActions"
		:enable-import="[[enableImport]]"
		:bulk-action-permission="bulkActionPermission"
		:import-permission="importPermission"
		@data-loaded="handleDataLoaded"
	>
		<!--
			[[primaryCellContent]] already opens with the primary value itself
			(generatePrimaryCellContentFromListFields emits it first, then any
			showOnMobileSub extras). Printing row.[[primaryKey]] above it as well
			rendered the same value twice, stacked — "free / free".
		-->
		<template #cell-[[primaryKey]]="{ row }">
			<div class="space-y-1">
				[[primaryCellContent]]
			</div>
		</template>

		[[customCellRenderers]]
	</ListPanel>
</template>

<script setup lang="ts">
import { ref, computed } from "vue";
import { useI18n } from 'vue-i18n';
import { useRoute } from 'vue-router';
import type { FilterField, BulkAction } from "@/types";
import type { ReportColumn } from '@/components/report-table';
import { ListPanel } from '@/components/list-panel';
// Required by the FK cell renderers injected into the template above:
// every foreign-key column is wrapped in <RelatedRecordLink>.
import RelatedRecordLink from '@/components/RelatedRecordLink.vue';
[[componentImports]]

const props = defineProps<{
	data: any
	/**
	 * Parent record uuid. Required when this tab is rendered inside the view
	 * MODAL, where there is no /:uuid route param to read — the list page's URL
	 * is still /{module}/list. Falling back to the route alone made the child
	 * list request /{module}//{feature}/list from the modal, which returned
	 * nothing and then crashed the table on the empty response.
	 */
	uuid?: string
}>()

const emit = defineEmits<{
	refresh: []
}>()

// Read parent ID from route params — reliable on hard refresh before props.data is populated.
// route.params.[[idParam]], not a hardcoded route.params.uuid (shelui-engine fork): this tab
// is mounted as a child route of the parent module's own details route, which registers an
// `:id` segment instead of `:uuid` for a has_uuid: false module (FrontendRoutesGenerator's own
// idParam) -- reading the literal 'uuid' key off route.params returned undefined there, and
// every endpoint this component builds from `uuid.value` below 404'd.
const { t } = useI18n()
const route = useRoute()
const uuid = computed(() => String(props.uuid || route.params.[[idParam]] || ''))

/**
 * Parent's primary key, used as the FK default when creating/editing a child.
 * The FK column ([[filterKey]]) is an integer, so it must receive the parent's
 * id — sending the uuid string here returned 422 "must be an integer" on every
 * create from a delegation tab. The parent record arrives as props.data (the
 * details page and the view modal both pass it).
 */
const parentId = computed(() => props.data?.[[parentIdField]] ?? null)

// Hiddens and defaults from configuration
const createHiddens = ref<Record<string, boolean>>([[createHiddens]])
const createDefaults = computed(() => {
	return {
		[[createDefaults]]
	}
})

const editHiddens = ref<Record<string, boolean>>([[editHiddens]])
const editDefaults = computed(() => {
	return {
		[[editDefaults]]
	}
})

// Filter fields - will be populated when data is loaded
const filterFields = ref<FilterField[]>([]);

// Define columns
const columns: ReportColumn[] = [
	[[columns]]
];

const handleDataLoaded = (data: Record<string, any>) => {
	filterFields.value = data.filterFields || [];
};

// API + delegation-scoped submit endpoints. Permission strings match
// DelegationConfigNormalizer::resolveOperationPermission() exactly (the same
// formula RoutesGenerator uses for the backend route guard), so frontend
// gating and backend enforcement can never drift apart.
const apiEndpoint = computed(() => `[[apiEndpointPath]]`);
const createSubmitUrl = computed(() => `[[createEndpointPath]]`);
const editSubmitUrl = computed(() => `[[editEndpointPath]]`);
const deleteSubmitUrl = computed(() => `[[deleteEndpointPath]]`);
const deleteCheckUrl = computed(() => `[[deleteCheckEndpointPath]]`);
const viewSubmitUrl = computed(() => `[[viewEndpointPath]]`);
const createPermission = [[createPermission]];
const editPermission = [[editPermission]];
const viewPermission = [[viewPermission]];
const deletePermission = [[deletePermission]];
const bulkActionPermission = [[bulkActionPermission]];
const importPermission = [[importPermission]];

const bulkActions = computed<BulkAction[]>(() => [[bulkActionsLiteral]]);

const testIdPrefix = '[[moduleName]]-[[featureName]]';

const panelRef = ref<InstanceType<typeof ListPanel> | null>(null)
</script>
