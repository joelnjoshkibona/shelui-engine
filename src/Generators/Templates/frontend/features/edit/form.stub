<template>
	<FormSkeleton v-if="isLoading" :sections="[{ name: 'Main Details', fields: 5, columns: 2 }]" />
	<div v-else-if="!hasPermission(props.permissionOverride ?? '[[PermissionBaseName]].edit')" class="flex flex-col items-center justify-center py-16 text-muted-foreground">
		<component :is="icons.ShieldOffIcon" class="h-10 w-10 mb-3 opacity-40" />
		<p class="text-sm font-medium">{{ $t('common.access_denied') }}</p>
		<p class="text-xs mt-1">{{ $t('common.no_permission_form') }}</p>
		<Button variant="outline" size="sm" class="mt-4" @click="cancel">{{ $t('common.back_to_list') }}</Button>
	</div>
	<form v-else @submit.prevent="handleSubmit" :class="modal ? 'flex flex-col flex-1 min-h-0' : ''">
		<div :class="modal ? 'flex-1 min-h-0 overflow-y-auto' : ''">
			[[draftBannerBlock]]
			[[formSections]]
			[[inlineItemsBlock]]
[[confirmCheckboxBlock]]
		</div>
		[[formFooter]]
	</form>
</template>

<script lang="ts">
export default {
	name: '[[ModuleName]]EditForm',
}
</script>

<script setup lang="ts">
import * as icons from "lucide-vue-next";
import {Button} from "@/components/ui/button";
import {useRouter} from "vue-router";
import {onMounted, ref, computed[[draftWatchImport]]} from "vue";
[[requestImportLine]]
import {toast} from "@/lib/toast";
import { usePermissions } from '@/composables/usePermissions';
[[draftImports]]
import FormSkeleton from '@/components/ui/loading/FormSkeleton.vue';
import { useI18n } from 'vue-i18n';
[[formFieldImports]]

const { hasPermission } = usePermissions();
const { t } = useI18n();

const props = defineProps({
	[[idParam]]: { type: String, required: true },
	modal: { type: Boolean, default: false },
	cancelLink: {default: '/[[moduleRoute]]/list'},
	title: {default: 'Basic Information'},
	hiddens: {default: () => {return {}}},
	defaults: {default: () => {return {}}},
	disabledFields: {default: () => {return []}},
	submitUrl: {default: null},
	[[splashPropBlock]]viewUrl: {default: null},
	// Overrides both hasPermission() checks above — null means "use the
	// default {module}.edit permission", same as every non-delegation
	// caller today. A delegation embedding this form via CrudListPanel
	// passes its own, separately-permissioned string here instead.
	permissionOverride: {default: null},
	successMessage: {default: null}
})
const emit = defineEmits(['cancel', 'updated'])
const router = useRouter()

// Computed endpoints with fallbacks
const submitEndpoint = computed(() => {
	return props.submitUrl || `/[[moduleRoute]]/${props.[[idParam]]}/edit`
})

[[splashBlock]]
const viewEndpoint = computed(() => {
	return props.viewUrl || `/[[moduleRoute]]/${props.[[idParam]]}/view`
})

[[inlineItemsFieldDefs]]
// Form data
const form = ref({
[[formFields]]
} as Record<string, any>)
[[fileRefsBlock]]

// Form state
const isSubmitting = ref(false)
const isLoading = ref(true)
const errors = ref<Record<string, string[]>>({})

[[draftSetupBlock]]
[[wizardStateBlock]]
// Submit form handler
const handleSubmit = async () => {
	try {
		isSubmitting.value = true
		errors.value = {}
		[[submitCall]]
		if (response.status) {
			toast.success(props.successMessage || t('[[moduleRoute]].updated_success'))
			[[discardDraftOnSuccess]]
			handleUpdated(response.data.id)
		} else {
			if (response.errors) {
				errors.value = response.errors
				toast.error(t('common.fix_validation'))
			} else {
				toast.error(response.message || t('[[moduleRoute]].updated_error'))
			}
		}
	} catch (error) {
		console.error('Error updating [[ModuleName]]:', error)
		toast.error(t('[[moduleRoute]].updated_error'))
	} finally {
		isSubmitting.value = false
	}
}

const cancel = () => {
	if (props.modal) { emit('cancel') } else { router.push(props.cancelLink) }
}

const handleUpdated = (id: any) => {
	if (props.modal) { emit('updated', { id }) } else { router.push(props.cancelLink) }
}

[[refreshAndSetBlock]]
// Track which fields should be disabled (from props or auto-detected from defaults)
const disabledFieldsList = ref<string[]>([...props.disabledFields])

// Computed to check if a field should be disabled
const isFieldDisabled = (fieldName: string) => {
	return disabledFieldsList.value.includes(fieldName)
}

// Load reference data and form data
onMounted(async () => {
	if (!hasPermission(props.permissionOverride ?? '[[PermissionBaseName]].edit')) {
		isLoading.value = false;
		return;
	}

	[[onMountedBlock]]

	// Load existing data
	isLoading.value = true
	const response = await sendGetRequest(viewEndpoint.value)
	if (response.status) {
		// Only merge keys that are already declared on `form` -- file-input
		// fields are intentionally excluded from form's initial declaration
		// (see generateFormFields()) so the corresponding File ref stays the
		// single source of truth for those fields. Merging response.data
		// wholesale would write the loaded record's raw column value (e.g. an
		// integer media id) back into form.value, which then gets submitted
		// and fails the backend's ["nullable","file"] validation rule on a
		// plain edit-without-reupload.
		const loadedData: Record<string, any> = {}
		Object.keys(form.value).forEach((key) => {
			if (key in response.data) loadedData[key] = response.data[key]
		})
		form.value = { ...form.value, ...loadedData }[[fieldLabelsSeedBlock]]
		[[draftCheckBlock]]
		// Apply defaults from props (overrides loaded data if needed)
		if (props.defaults && Object.keys(props.defaults).length > 0) {
			form.value = { ...form.value, ...props.defaults }
			// Auto-populate disabledFields if defaults are provided and no explicit disabledFields
			if (props.disabledFields.length === 0) {
				Object.keys(props.defaults).forEach(key => {
					if (props.defaults[key] !== undefined && props.defaults[key] !== null && props.defaults[key] !== '') {
						if (!disabledFieldsList.value.includes(key)) {
							disabledFieldsList.value.push(key)
						}
					}
				})
			}
		}
		// Coerce any null values to '' so InputField's String|Number-only modelValue prop doesn't warn
		Object.keys(form.value).forEach((key) => {
			if (form.value[key] === null) {
				form.value[key] = ''
			}
		})
	} else {
		toast.error(t('[[moduleRoute]].failed_load'))
	}
	isLoading.value = false
})
[[draftWatchBlock]]
</script>
