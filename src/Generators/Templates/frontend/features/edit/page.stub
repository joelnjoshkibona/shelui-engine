<template>
	<MainLayout :title="$t('[[moduleRoute]].edit_btn')"
		:back-link="backLink"
		:breadcrumbs="[{label: $t('common.dashboard'), href: '/dashboard'}, {label: $t('[[moduleRoute]].title'), href: '/[[moduleRoute]]/list'}, {label: $t('common.edit'), href: null}]">
		<div class="px-1 pt-2">
			<[[ModuleName]]EditForm :[[idParam]]="id" :cancel-link="backLink" />
		</div>
	</MainLayout>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import { useRoute } from 'vue-router'
import MainLayout from '@/layouts/MainLayout.vue'
import [[ModuleName]]EditForm from './Components/[[ModuleName]]EditForm.vue'

const route = useRoute()
const id = route.params.[[idParam]] as string

// Get back link from query or default to details page
const backLink = computed(() => {
	return (route.query.back as string) || `/[[moduleRoute]]/${id}/details`
})
</script>
