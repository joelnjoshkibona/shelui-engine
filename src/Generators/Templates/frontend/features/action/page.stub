<template>
	<MainLayout
		title="[[ActionLabel]]"
		:back-link="backLink"
		:breadcrumbs="[{ label: $t('common.dashboard'), href: '/dashboard' }, { label: $t('[[moduleRoute]].title'), href: '/[[moduleRoute]]/list' }, { label: '[[ActionLabel]]', href: null }]"
	>
		<div class="px-1 pt-2">
			<!--
				Thin shell, mirroring the generated CreatePage: all of the
				action's behaviour lives in the Form component, which the view
				modal renders with `modal` instead. Nothing here needs editing
				when you add fields — edit the Form.
			-->
			<[[ModuleName]][[ActionName]]Form :[[idParam]]="uuid" :cancel-link="backLink" />
		</div>
	</MainLayout>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import { useRoute } from 'vue-router'
import MainLayout from '@/layouts/MainLayout.vue'
import [[ModuleName]][[ActionName]]Form from './Components/[[ModuleName]][[ActionName]]Form.vue'

const route = useRoute()

// shelui-engine fork: route.params.[[idParam]], not a hardcoded
// route.params.uuid -- this route is registered with an `:id` segment
// instead of `:uuid` for a has_uuid: false module
// (FrontendRoutesGenerator::generateActionRoutes()); the local variable
// stays named `uuid` (cosmetic -- see BaseComponentGenerator::idParam()'s
// docblock), only its value source changes.
const uuid = computed(() => String(route.params.[[idParam]] ?? ''))

const backLink = computed(() => {
	return (route.query.back as string) || '[[actionCancelLink]]'
})
</script>
