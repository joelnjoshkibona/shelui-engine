<script lang="ts">
export default {
	name: '[[ModuleName]]DeleteForm',
}
</script>

<script setup lang="ts">
import { useRouter } from "vue-router";
import { AlertTriangleIcon, AlertCircleIcon, CheckCircleIcon, Loader2Icon, Trash2Icon, ExternalLinkIcon } from "lucide-vue-next";
import { Button } from "@/components/ui/button";
import { onMounted, ref, computed } from "vue";
import { useI18n } from 'vue-i18n';
import { sendGetRequest, sendDeleteRequest } from "@/helpers";
import { toast } from "@/lib/toast";
import { usePermissions } from '@/composables/usePermissions';
import InputField from '@/components/form-fields/InputField.vue';
import { Alert, AlertDescription } from "@/components/ui/alert";

const { t } = useI18n();

const props = defineProps({
	modal: { type: Boolean, default: false },
	[[idParam]]: { type: String, required: true },
	cancelLink: { default: '/[[moduleRoute]]/list' },
	// Mirrors Create/EditForm's existing submitUrl override pattern —
	// null means "use this module's own default endpoint", same as every
	// non-delegation caller today. checkUrl overrides the relationship
	// -check GET the delete flow always runs first.
	submitUrl: { default: null },
	checkUrl: { default: null },
	// Overrides the hasPermission() check below — null means "use the
	// default {module}.delete permission".
	permissionOverride: { default: null },
})

const emit = defineEmits(['cancel', 'deleted'])

const router = useRouter()
const { hasPermission } = usePermissions()

// Computed endpoints with fallbacks — mirrors Create/EditForm's existing pattern.
const checkEndpoint = computed(() => props.checkUrl || `/[[moduleRoute]]/${props.[[idParam]]}/delete/check`)
const submitEndpoint = computed(() => props.submitUrl || `/[[moduleRoute]]/${props.[[idParam]]}/delete`)

// State
const isLoading = ref(true)
const isDeleting = ref(false)
const record = ref<Record<string, any> | null>(null)
const relationships = ref<Array<{ name: string; count: number; label: string; message?: string }>>([])
const confirmText = ref('')
const canDelete = ref(false)
const error = ref('')

// Check if user typed YES correctly
const isConfirmValid = computed(() => confirmText.value === 'YES')

// Load record and check relationships
async function loadRecord() {
	isLoading.value = true
	error.value = ''

	try {
		const response = await sendGetRequest(checkEndpoint.value)

		if (response.status) {
			record.value = response.data.record
			relationships.value = response.data.relationships || []
			canDelete.value = response.data.can_delete
		} else {
			error.value = response.message || 'Failed to load record'
			toast.error(error.value)
		}
	} catch (err) {
		console.error('Error loading record:', err)
		error.value = t('delete.failed_load')
		toast.error(error.value)
	} finally {
		isLoading.value = false
	}
}

// Handle delete
async function handleDelete() {
	if (!isConfirmValid.value || !canDelete.value) return

	isDeleting.value = true

	try {
		const response = await sendDeleteRequest(submitEndpoint.value)

		if (response.status) {
			toast.success(t('delete.deleted_success'))
			if (props.modal) { emit('deleted') }
			else { router.push('/[[moduleRoute]]/list') }
		} else {
			if (response.data?.relationships) {
				relationships.value = response.data.relationships
				canDelete.value = false
				toast.error(t('delete.relationships_found'))
			} else {
				toast.error(response.message || t('delete.delete_error'))
			}
		}
	} catch (err) {
		console.error('Error deleting:', err)
		toast.error(t('delete.delete_error_retry'))
	} finally {
		isDeleting.value = false
	}
}

const cancel = () => {
	if (props.modal) { emit('cancel') }
	else { router.push(props.cancelLink) }
}

onMounted(() => {
	loadRecord()
})
</script>

<template>
	<!-- Loading -->
	<div v-if="isLoading" class="flex items-center justify-center py-12">
		<Loader2Icon class="h-8 w-8 animate-spin text-muted-foreground" />
	</div>

	<!-- Permission denied -->
	<div v-else-if="!hasPermission(props.permissionOverride ?? '[[PermissionBaseName]].delete')" class="p-4 text-sm text-destructive bg-destructive/10 rounded">
		<p class="font-medium">{{ $t('common.access_denied') }}</p>
		<p>{{ $t('common.no_permission_delete') }}</p>
	</div>

	<!-- Error -->
	<Alert v-else-if="error" variant="destructive">
		<AlertDescription>{{ error }}</AlertDescription>
	</Alert>

	<!-- Confirmation form -->
	<div v-else-if="record" :class="!modal ? 'rounded-md border overflow-hidden' : ''">
		<div class="p-4 space-y-4">

			<!-- Warning heading -->
			<div class="flex items-center gap-2">
				<AlertTriangleIcon class="h-4 w-4 text-destructive flex-shrink-0" />
				<span class="text-sm font-semibold text-destructive">{{ $t('delete.danger_zone') }}</span>
			</div>

			<!-- Description -->
			<p class="text-sm text-muted-foreground">
				{{ $t('delete.confirm_intro') }} <strong>"{{ record.name || record.title || 'Record' }}"</strong>.
				This action cannot be undone.
			</p>

			<!-- Relationships warning -->
			<Alert v-if="!canDelete" variant="destructive">
				<AlertCircleIcon class="h-4 w-4" />
				<AlertDescription>
					<p class="font-medium mb-1">{{ $t('delete.cannot_delete_heading') }}</p>
					<ul class="list-disc list-inside space-y-0.5 text-xs">
						<li v-for="rel in relationships" :key="rel.name">
							<strong>{{ rel.label }}</strong>: {{ rel.message || `${rel.count} record(s)` }}
						</li>
					</ul>
				</AlertDescription>
			</Alert>

			<!-- No relationships -->
			<Alert v-else variant="default">
				<CheckCircleIcon class="h-4 w-4" />
				<AlertDescription>{{ $t('delete.can_delete') }}</AlertDescription>
			</Alert>

			<!-- Confirm input -->
			<div v-if="canDelete">
				<p class="text-sm font-medium mb-2">
					{{ $t('delete.type_yes') }} <code class="bg-muted px-1.5 py-0.5 rounded font-bold">YES</code> below:
				</p>
				<InputField
					id="confirm"
					label=""
					v-model="confirmText"
					:disabled="isDeleting"
					:placeholder="$t('delete.type_yes_placeholder')"
					class="max-w-xs"
				/>
			</div>

		</div>
		<div class="flex items-center justify-between px-4 py-3 border-t">
			<router-link v-if="modal" :to="`/[[moduleRoute]]/${[[idParam]]}/delete`">
				<Button type="button" variant="ghost" size="sm" class="text-muted-foreground">
					<ExternalLinkIcon class="h-3.5 w-3.5 mr-1.5" />
					{{ $t('entity.open_full') }}
				</Button>
			</router-link>
			<div v-else />
			<div class="flex gap-3">
				<Button v-if="modal" type="button" variant="outline" size="sm" @click="cancel" :disabled="isDeleting">
					{{ $t('common.cancel') }}
				</Button>
				<Button v-if="canDelete" type="button" variant="destructive" size="sm" data-testid="[[moduleName]]-confirm-delete" @click="handleDelete" :disabled="!isConfirmValid || isDeleting">
					<Loader2Icon v-if="isDeleting" class="h-3.5 w-3.5 mr-1.5 animate-spin" />
					<Trash2Icon v-else class="h-3.5 w-3.5 mr-1.5" />
					{{ isDeleting ? $t('delete.deleting') : $t('delete.delete_record') }}
				</Button>
			</div>
		</div>
	</div>
</template>
